<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>LiveSplit.HarryPotter</AssemblyName>
    <RootNamespace>LiveSplit.UnrealLoads</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(LiveSplitPath)Components\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\Components\</OutputPath>
    <DefineConstants></DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GITHUB_ACTIONS)' == 'true' ">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LiveSplit.Core">
      <HintPath>$(LiveSplitPath)LiveSplit.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UpdateManager">
      <HintPath>$(LiveSplitPath)UpdateManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ExportTableParser.cs" />
    <Compile Include="GameMemory.cs" />
    <Compile Include="Games\GameSupport.cs" />
    <Compile Include="Games\HarryPotter1.cs" />
    <Compile Include="Games\HarryPotter3.cs" />
    <Compile Include="Games\HarryPotter3Detours.cs" />
    <Compile Include="Games\HarryPotter3Speed.cs" />
    <Compile Include="Games\HarryPotter2.cs" />
    <Compile Include="Games\HarryPotter2Detours.cs" />
    <Compile Include="Hooks.cs" />
    <Compile Include="IGameMemory.cs" />
    <Compile Include="IUnrealLoadsSettings.cs" />
    <Compile Include="Map.cs" />
    <Compile Include="PE.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="UnrealLoadsComponent.cs" />
    <Compile Include="UnrealLoadsFactory.cs" />
    <Compile Include="UnrealLoadsSettings.cs" SubType="UserControl" />
    <Compile Include="UnrealLoadsSettings.Designer.cs" DependentUpon="UnrealLoadsSettings.cs" />
    <Compile Include="Utils.cs" />
    <EmbeddedResource Update="UnrealLoadsSettings.resx" DependentUpon="UnrealLoadsSettings.cs" />
    <None Include="..\Components\update.LiveSplit.HarryPotter.xml" Link="update.LiveSplit.HarryPotter.xml" />
  </ItemGroup>

</Project>
